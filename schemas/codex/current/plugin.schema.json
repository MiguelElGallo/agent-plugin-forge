{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MiguelElGallo/agent-plugin-forge/schemas/codex/current/plugin.schema.json",
  "title": "Agent Plugin Forge Codex compatibility contract",
  "$comment": "Recursive [TODO: ...] placeholder rejection is enforced by codex_contract.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "description", "author", "skills", "interface"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "homepage": { "$ref": "#/$defs/httpsUrl" },
    "repository": { "$ref": "#/$defs/httpsUrl" },
    "license": { "type": "string", "minLength": 1 },
    "keywords": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "skills": { "const": "./skills/" },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayName",
        "shortDescription",
        "longDescription",
        "developerName",
        "category",
        "capabilities",
        "defaultPrompt"
      ],
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
        "shortDescription": { "type": "string", "minLength": 1 },
        "longDescription": { "type": "string", "minLength": 1 },
        "developerName": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "defaultPrompt": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "websiteURL": { "$ref": "#/$defs/httpsUrl" }
      }
    }
  },
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[^/\\s]+(?:/[^\\s]*)?$"
    }
  }
}
